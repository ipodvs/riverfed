{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level Claude Code settings. Pre-approves routine commands so the agent can iterate quickly on this codebase without constant prompts. Keep ASK rules for anything that touches credentials, the network beyond localhost, or destructive ops.",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(py -3.13 wiki/scripts/*)",
      "Bash(py -3.13 wiki\\scripts\\*)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv\\Scripts\\python.exe *)",
      "Bash(convert.cmd *)",
      "Bash(serve.cmd)",
      "Bash(stop.cmd)",
      "Bash(marp *)",
      "Bash(npx marp *)",
      "Bash(taskkill /F /IM pythonw.exe*)",
      "Bash(wscript.exe start.vbs*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf C:*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force-with-lease*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(.venv/Scripts/python.exe -m pip install:*)",
      "Bash(winget install:*)",
      "Bash(npm install:*)",
      "Bash(npx -y *)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "WebFetch"
    ]
  }
}
