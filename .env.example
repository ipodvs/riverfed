# Copy this file to `.env` (gitignored) and adjust what you need.
# The server and the wiki scripts read .env at startup; real environment
# variables win over it.
#
# No API key is needed for the agent pipeline: it runs through the agent
# CLI you are logged in to (`claude`, `codex` or `grok`). Leave
# ANTHROPIC_API_KEY unset: the code never reads it, and a value would leak
# into the spawned `claude` process and override its login.

# After this many ingests, auto-run wiki/scripts/promote_backlog.py to
# promote accumulated "watch for…" candidates in log.md into full
# concept/entity pages. Set to 0 to disable auto-review (you can still
# trigger it manually from the UI's "Run review now" button).
AUTO_REVIEW_THRESHOLD=5

# OPTIONAL: local, API-key-free Whisper configuration.
# `./setup.sh` installs whisper.cpp plus the checksum-pinned 75 MiB smoke
# model. Install the 547 MiB production multilingual model with:
#   ./setup.sh --whisper-model large-v3-turbo-q5_0 --skip-python-deps
# If both models are present, production wins unless this is set explicitly.
# RIVERFED_WHISPER_MODEL=large-v3-turbo-q5_0
# RIVERFED_WHISPER_DIR=/custom/cache/path
# WHISPER_CPP_BIN=/custom/path/whisper-cli

# OPTIONAL: remote final fallback for caption-less YouTube videos.
# convert.py tries human captions, automatic captions, and local whisper.cpp
# before sending audio to Groq. Configuring this key is the remote opt-in.
# Long audio is segmented automatically. Leave unset for local-only privacy.
# Get a free key at https://console.groq.com.
# GROQ_API_KEY=gsk_your-key-here

# OPTIONAL — auto-ingest watcher cadence (minutes between channel sweeps
# while the server runs; 0 disables the background sweep — the "Check
# now" button on / still works).
WATCHER_INTERVAL_MIN=360

# OPTIONAL — where personal knowledge bases (vaults) live. Defaults to
# ~/RiverfedVaults. Vaults are YOUR data and live outside the product
# repo since the C1 split; repo-shipped demo vaults (wikis/riverfed-ops)
# resolve regardless of this setting.
# RIVERFED_VAULTS_DIR=C:/Users/you/RiverfedVaults

# OPTIONAL — local server port (default 8765).
# RIVERFED_PORT=8765

# OPTIONAL — hosted Writer origins allowed to read the /api/writer/*
# knowledge-pack bridge (comma-separated). Loopback origins always work.
# RIVERFED_WRITER_ORIGINS=https://writer.example.com

# Which Claude model the pipeline (ingest / review / all Studio
# generators) runs on. Unset, `claude -p` inherits your interactive
# Claude Code default from ~/.claude settings — whatever you chat with
# is also what ingests. Two modes:
#   CLAUDE_MODEL=opus              tier ceiling — tracks the newest
#                                  Opus-family model (4.8 today, 4.9 the
#                                  day it ships), never jumps a tier.
#                                  Needs a current CLI (`claude update`;
#                                  2.1.71's stale table gave opus 4-6).
#   CLAUDE_MODEL=claude-opus-4-8   hard pin to one exact model.
# House policy: run the pipeline one tier below frontier (opus), keeping
# frontier-tier quota for interactive sessions.
CLAUDE_MODEL=opus

# OPTIONAL — the Codex twin (`codex exec --model ...`), ready for when
# GPT-5.6's tiers land. Unset = your ~/.codex/config.toml default
# (gpt-5.5 today, already the sub-frontier tier). An explicit pin the
# installed codex CLI can't honor fails loudly, never silently.
# CODEX_MODEL=gpt-5.5

# OPTIONAL — the Grok twin (`grok --model ...`). Unset = grok's own
# default (grok-4.7 on grok 1.0.41), which is what we ship. Note this
# knob does NOT carry the tier-ceiling meaning CLAUDE_MODEL has:
# grok-4.7, grok-4.6, and grok-4.5 are versions of one model, not tiers
# of a family, so there is no "one below frontier" rung to hold. Set it
# only to pin a specific version.
# GROK_MODEL=grok-4.7

# OPTIONAL — pin an agent CLI binary instead of trusting PATH. Useful
# when a launchd/systemd service has a thinner PATH than your shell
# (grok's installer drops it in ~/.local/bin, which services often miss).
# CLAUDE_BIN=/Users/you/.local/bin/claude
# CODEX_BIN=/opt/homebrew/bin/codex
# GROK_BIN=/Users/you/.local/bin/grok
